# Servidor
NODE_ENV=production
PORT=5000

# MongoDB (obligatoria)
MONGODB_URI=mongodb://mongo:27017/portfolio

# Secretos obligatorios (minimo 32 caracteres). Generar con: openssl rand -hex 32
JWT_SECRET=
IP_HASH_SALT=

# URL publica del frontend (CORS)
FRONTEND_URL=https://example.com

# Proxies de confianza delante de la API (nginx = 1, Cloudflare + nginx = 2). Vacio = redes privadas
TRUSTED_PROXY_HOPS=
