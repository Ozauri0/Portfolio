# Frontend (Next.js)
# URL interna de la API para el proxy /api/* (red de Docker)
INTERNAL_API_URL=http://portfolio-api:5000

# Numero de proxies de confianza delante de la app (nginx = 1, Cloudflare + nginx = 2)
TRUSTED_PROXY_HOPS=1

# EmailJS (formulario de contacto, solo servidor)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
